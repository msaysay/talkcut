  "structure": {
    "opening": {
      "goal": "为什么值得看",
      "max_hook_seconds": 3,
      "styles": [
        "提问式",
        "讲故事",
        "笃定式",
        "对比式",
        "夸张式",
        "纠正式",
        "喊话式"
      ],
      "business_story_first_seconds": 20,
      "business_story_must_include": [
        "流量切口",
        "资格背书词",
        "可验证成绩",
        "观看理由"
      ]
    },
    "development": {
      "goal": "为什么相信你",
      "support_types": [
        "权威数据",
        "专家说法",
        "历史趋势",
        "名人案例",
        "实验对比",
        "经济账",
        "客户案例",
        "亲身经历"
      ],
      "support_count_range": [
        1,
        3
      ]
    },
    "close": {
      "goal": "为什么记住你或行动",
      "elements": [
        "资格背书词",
        "产品点到为止",
        "价值总结",
        "升华",
        "互动钩子",
        "引流CTA"
      ],
      "cta_window_ratio": [
        0.05,
        0.15
      ]
    },
    "pacing_ratios": {
      "pillar_daily": {
        "opening": [
          0.1,
          0.2
        ],
