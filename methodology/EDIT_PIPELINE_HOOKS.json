  "cut_heuristics": [
    {
      "id": "hook_first_3s",
      "priority": 1,
      "rule": "成片0-3秒必须落在钩子完整意群；此前无效准备动作删除或后移"
    },
    {
      "id": "drop_pre_hook_filler",
      "priority": 2,
      "rule": "删除清嗓、整理仪容、无意义寒暄、开拍指令"
    },
    {
      "id": "prefer_best_emotion_take",
      "priority": 3,
      "rule": "多take时优先情绪与对象感最好的一遍，而非口误最少"
    },
    {
      "id": "keep_human_moments",
      "priority": 4,
      "rule": "默认保留笑、气口、自然停顿；仅删技术失误与冗长沉默"
    },
    {
      "id": "one_thesis_only",
      "priority": 5,
      "rule": "删除与主观点/主营销三问无关的支线"
    },
    {
      "id": "dedupe_repeats",
      "priority": 6,
      "rule": "同义反复超过有效次数时保留最清晰或情绪最佳一次"
    },
    {
      "id": "support_block_cuts",
      "priority": 7,
      "rule": "展段按支撑块分切；块边界可插证据B-roll"
    },
    {
      "id": "micro_jumpcut_fillers",
      "priority": 8,
      "rule": "可微跳切填充词但保持呼吸自然，禁止机关枪节奏"
    },
    {
      "id": "interview_self_contained",
      "priority": 9,
      "rule": "对谈可删提问，回答须自带语境仍自洽"
    },
    {
      "id": "insert_evidence_on_proof_lines",
      "priority": 10,
      "rule": "在数据/做过/客户反馈类句子处插入证据画面"
    },
    {
      "id": "protect_emotion_peaks",
      "priority": 11,
      "rule": "勿在情绪最高点硬切，在峰后落点切"
    },
    {
      "id": "clean_cta_tail",
      "priority": 12,
      "rule": "CTA前后短静音或弱化BGM；删除CTA后无效闲聊"
    },
    {
      "id": "story_chapter_cuts",
      "priority": 13,
      "rule": "业务故事片按起点-冲突-萌发-求索-立志-行动-成果-升华分章"
    },
    {
      "id": "direct_close_keep_formula",
      "priority": 14,
      "rule": "直答成交片完整保留固定问句开场，勿打乱骨架"
    }
  ],
  "caption_emphasis": [
    {
      "trigger": "hook_keywords",
      "action": "大号字幕/高对比，短时显示"
    },
    {
      "trigger": "counterintuitive_claim",
      "action": "整句或关键词强调"
    },
    {
      "trigger": "numbers",
      "action": "数字放大，可短定格"
    },
    {
      "trigger": "gold_line",
      "action": "全句字幕+轻动效"
    },
    {
      "trigger": "credibility_phrase",
      "action": "名片条中左不挡脸，2-4秒，短视频通常不超过2次"
    },
    {
      "trigger": "pain_visual_phrase",
      "action": "画面感关键词高亮"
    },
    {
      "trigger": "cta_keyword",
      "action": "特大字幕且与口播关键字一致"
    },
    {
      "trigger": "list_item",
      "action": "序号徽章，一点一切换"
    },
    {
      "trigger": "color_limit",
      "action": "单条主色不超过3种"
    }
  ],
  "cover_title_patterns": [
    {
      "id": "question",
      "pattern": "你知道……吗？ / 为什么……还会……？"
    },
    {
      "id": "number",
      "pattern": "N个…… / ……花了多少……"
    },
    {
      "id": "counterintuitive",
      "pattern": "真正……的人，往往……"
    },
    {
      "id": "correction",
      "pattern": "别再以为……"
    },
    {
      "id": "callout",
      "pattern": "……的人注意了"
    },
    {
      "id": "ranking_extreme",
      "pattern": "最……的N个……"
    },
    {
      "id": "contrast",
      "pattern": "A和B，……差别有多大"
    },
    {
      "id": "direct_close",
      "pattern": "为什么……会找我……"
    },
    {
      "id": "cover_formula",
      "pattern": "关键词 + 数字 + 人（表情/立场）",
      "person_ratio": 0.66
    }
  ],
